# copy this file to `.env` and fill in your key
# NEVER commit `.env` — it should be in .gitignore

# openai
OPENAI_API_KEY=sk-proj-...

# openrouter (cheapest option — one key, many models)
OPENROUTER_API_KEY=sk-or-...

# anthropic
ANTHROPIC_API_KEY=sk-ant-...

# which provider the harness uses (openai | openrouter | anthropic)
PROVIDER=openai

# which model to test (format depends on provider)
# openai:    gpt-4o | gpt-4o-mini | o1-preview
# openrouter: openai/gpt-4o | anthropic/claude-3.5-sonnet | google/gemini-pro-1.5
# anthropic: claude-3-5-sonnet-20241022 | claude-3-opus-20240229
MODEL=gpt-4o
